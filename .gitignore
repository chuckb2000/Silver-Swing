# dependencies and build output (rebuilt by npm install / npm run build)
node_modules/
game/dist/
game/test-results/
game/playwright-report/
__pycache__/
*.pyc

# pipeline intermediates (rebuilt by `make course NAME=<id>` from raw/ + edited/)
data/*/build/

# local Cloudflare dev state (wrangler pages dev)
.wrangler/

# editor / OS clutter
.DS_Store
.vscode/
*.swp

# lidar point clouds are archived as GitHub release assets, not in git (data/<course>/DATA_REQUEST.md)
data/*/raw/*.laz
# USGS 1 m DEM tiles (~100 MB) are archived in the GitHub release named in data/<course>/DATA_REQUEST.md
data/*/raw/USGS_1M_*.tif
data/*/raw/**/*.laz
data/*/raw/**/*.zip
